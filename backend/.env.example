# =============================================================
# MAUSAM — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# Application
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=true
LOG_LEVEL=INFO

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mausam_dev

# AWS Region (used by all AWS SDK calls)
AWS_REGION=ap-south-1

# AWS Credentials (leave blank in Lambda — uses IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon S3
S3_BUCKET_NAME=mausam-documents-dev
S3_REGION=ap-south-1

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_ENABLED=false

# Amazon Textract
TEXTRACT_ENABLED=false

# Amazon Translate
TRANSLATE_ENABLED=false

# Amazon Polly
POLLY_ENABLED=false

# Amazon Cognito
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_ENABLED=false

# AWS KMS
KMS_KEY_ID=
KMS_SIGNING_ENABLED=false

# Amazon SNS
SNS_TOPIC_ARN=
SNS_ENABLED=false

# Amazon SES / Email
SES_FROM_EMAIL=noreply@mausam.example.com
SES_ENABLED=false

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo mode
DEMO_MODE=true
DEMO_BUSINESS_ID=demo_ramesh_textiles

# Passport signing (dev fallback when KMS_SIGNING_ENABLED=false)
DEV_SIGNING_KEY=dev-only-not-for-production

# API rate limiting
RATE_LIMIT_PER_MINUTE=60
